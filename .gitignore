__pycache__/
*.pyc

# The BEAM writes this where it dies; the trope gate runs elixir.
erl_crash.dump

/_build/
/deps/

# RFD66606-2232: README.md, DETAILS.md and the serial registers are rendered from the
# .exs sources by `mix rfd.render`; the sources are what is tracked. Nothing else
# belongs under rfd/NNNN-slug/ -- apparatus lives in apparatus/NNNN-slug/, and
# check_rfd_dirs_rendered_only.py fails a tracked file that lands there.
rfd/[0-9][0-9][0-9][0-9]-*/README.md
rfd/[0-9][0-9][0-9][0-9]-*/DETAILS.md
/SERIALS.usda
/SERIALS-*.usda

# Artifacts the apparatus writes where it runs. The sources beside them -- the
# scripts, pixi.toml, pixi.lock and the exported chain data -- are tracked.
apparatus/.pixi/
apparatus/MUJOCO_LOG.TXT

# This repository is a project in a `repo` client, and an agent session puts its
# worktrees and local state here. An untracked tree inside a managed checkout stops
# sync.exs's preflight for every project at once, so one session's 28 MB worktree
# held a whole sync on 2026-10-01. None of it is ours to track.
/.claude/

# The RFD site; the pages workflow generates it (RFD66606-2240).
/docs/

# nix build output links
/result*
